generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATIONS_USER
  SALES_USER
}

enum WorkOrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
}

enum OrderStatus {
  RESERVED
  COMPLETED
  CANCELLED
}

enum InventoryTransactionType {
  IN
  OUT
  RESERVATION
  RELEASE
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  locationId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location              Location?              @relation(fields: [locationId], references: [id])
  assignedWorkOrders    WorkOrder[]            @relation("AssignedUser")
  createdWorkOrders     WorkOrder[]            @relation("CreatedBy")
  createdTransfers      StockTransfer[]        @relation("TransferCreatedBy")
  createdOrders         CustomerOrder[]        @relation("OrderCreatedBy")
  inventoryTransactions InventoryTransaction[]
}

model Location {
  id   Int    @id @default(autoincrement())
  name String @unique

  users                 User[]
  inventories           Inventory[]
  workOrders            WorkOrder[]
  sourceTransfers       StockTransfer[]        @relation("SourceLocation")
  destinationTransfers  StockTransfer[]        @relation("DestinationLocation")
  customerOrders        CustomerOrder[]
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactions")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  items Item[]
}

model Item {
  id         Int      @id @default(autoincrement())
  name       String
  sku        String   @unique
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category              Category               @relation(fields: [categoryId], references: [id])
  batches               Batch[]
  inventories           Inventory[]
  workOrders            WorkOrder[]
  stockTransfers        StockTransfer[]
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]
}

model Batch {
  id          Int    @id @default(autoincrement())
  itemId      Int
  batchNumber String

  item         Item                   @relation(fields: [itemId], references: [id])
  inventories  Inventory[]
  transactions InventoryTransaction[] @relation("BatchTransactions")

  @@unique([itemId, batchNumber])
}

model Inventory {
  id               Int      @id @default(autoincrement())
  itemId           Int
  locationId       Int
  batchId          Int?
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  item         Item                   @relation(fields: [itemId], references: [id])
  location     Location               @relation(fields: [locationId], references: [id])
  batch        Batch?                 @relation(fields: [batchId], references: [id])
  transactions InventoryTransaction[] @relation("InventoryTransactions")

  @@unique([itemId, locationId, batchId])
  @@index([itemId, locationId])
}

model InventoryTransaction {
  id             Int                      @id @default(autoincrement())
  transactionKey String                   @unique
  inventoryId    Int
  itemId         Int
  locationId     Int
  batchId        Int?
  type           InventoryTransactionType
  quantity       Int
  createdById    Int
  createdAt      DateTime                 @default(now())

  inventory Inventory @relation("InventoryTransactions", fields: [inventoryId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  location  Location  @relation("InventoryTransactions", fields: [locationId], references: [id])
  batch     Batch?    @relation("BatchTransactions", fields: [batchId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([itemId, locationId])
  @@index([inventoryId])
  @@index([createdById])
}

model WorkOrder {
  id               Int             @id @default(autoincrement())
  workOrderNumber  String          @unique
  locationId       Int
  itemId           Int
  requiredQuantity Int
  assignedUserId   Int
  createdById      Int
  status           WorkOrderStatus @default(ASSIGNED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  location     Location @relation(fields: [locationId], references: [id])
  item         Item     @relation(fields: [itemId], references: [id])
  assignedUser User     @relation("AssignedUser", fields: [assignedUserId], references: [id])
  createdBy    User     @relation("CreatedBy", fields: [createdById], references: [id])

  @@index([locationId])
  @@index([itemId])
  @@index([assignedUserId])
  @@index([status])
}

model StockTransfer {
  id                    Int            @id @default(autoincrement())
  transferNumber        String         @unique
  sourceLocationId      Int
  destinationLocationId Int
  itemId                Int
  quantity              Int
  status                TransferStatus @default(REQUESTED)
  createdById           Int
  dispatchedAt          DateTime?
  receivedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  sourceLocation      Location @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation Location @relation("DestinationLocation", fields: [destinationLocationId], references: [id])
  item                Item     @relation(fields: [itemId], references: [id])
  createdBy           User     @relation("TransferCreatedBy", fields: [createdById], references: [id])

  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([itemId])
  @@index([status])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders CustomerOrder[]
}

model CustomerOrder {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  customerId  Int
  locationId  Int
  createdById Int
  status      OrderStatus @default(RESERVED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer  Customer    @relation(fields: [customerId], references: [id])
  location  Location    @relation(fields: [locationId], references: [id])
  createdBy User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items     OrderItem[]

  @@index([customerId])
  @@index([locationId])
  @@index([createdById])
  @@index([status])
}

model OrderItem {
  id       Int @id @default(autoincrement())
  orderId  Int
  itemId   Int
  quantity Int

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item          @relation(fields: [itemId], references: [id])

  @@unique([orderId, itemId])
  @@index([itemId])
}
